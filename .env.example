# Copy to .env. Never commit real credentials.
# Local Docker access: frontend and API on the same origin.
APP_ORIGIN=http://localhost:8180
COOKIE_SECURE=false
SESSION_TRANSPORT=cookie
APP_PORT=8180

# Existing Firebase Hosting domain + MacBook Pro Funnel API:
# APP_ORIGIN=https://ewha-consulting.web.app
# COOKIE_SECURE=true
# SESSION_TRANSPORT=bearer
# Public frontend API URL belongs in .env.hosting, not this server file.

# Generate secrets individually with openssl rand -hex 32.
# Use URL-safe letters/numbers (hex recommended) for the Mongo credentials.
SESSION_SECRET=
MONGO_ROOT_USERNAME=calendar_root
MONGO_ROOT_PASSWORD=
# Generate with: openssl rand -base64 48
MONGO_REPLICA_KEY=
MONGODB_DB=ewh_consulting

# Only needed for running Node outside Docker (npm run dev:server).
# npm run dev proxies /api to this local Node server.
# MONGODB_URI=mongodb://USER:PASSWORD@YOUR-DEV-MONGO:27017/?replicaSet=rs0&authSource=admin
# PORT=3001
