{
  "name": "ewh-consulting-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "build:hosting": "node scripts/build-firebase-hosting.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs scripts/*.test.mjs infra/cloudflare-api-gateway/*.test.mjs",
    "db:user": "node --env-file=.env scripts/manage-user.mjs",
    "db:import": "node --env-file=.env scripts/import-firestore.mjs"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@tailwindcss/vite": "^4.1.18",
    "connect-mongo": "^5.1.0",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "file-saver": "^2.0.5",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.562.0",
    "mongodb": "^6.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "tailwindcss": "^4.1.18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
